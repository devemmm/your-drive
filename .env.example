# =============================================================================
# Port mappings (override per environment to avoid conflicts)
# Defaults chosen to avoid common dev ports and the staging server's allocations.
# =============================================================================
DB_PORT=5433
SERVER_PORT=3003
CLIENT_PORT=8480
MINIO_API_PORT=9480
MINIO_CONSOLE_PORT=9481

# =============================================================================
# Server
# =============================================================================
NODE_ENV=development
SECRET_KEY=your-jwt-secret-change-me
DEFAULT_CURRENCY=RWF

# URLs (must match the port mappings above)
FRONTEND_URL=http://localhost:8480
BACKEND_URL=http://localhost:3003
VITE_API_URL=http://localhost:3003

# =============================================================================
# Admin seed credentials
# =============================================================================
ADMIN_EMAIL=admin@yourdrive.com
ADMIN_PASSWORD=Admin123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# =============================================================================
# S3-compatible storage (MinIO for local dev, Hetzner/AWS for prod)
# =============================================================================
# S3_ENDPOINT: internal URL the server uses to reach storage.
#   - Inside docker-compose use the service name: http://minio:9000
#   - For Hetzner/AWS use the provider endpoint.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=your-drive
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# S3_PUBLIC_URL: what the server writes into the DB for image URLs.
#   Must be reachable from browsers/mobile clients.
#   - Local:   http://localhost:9480/your-drive
#   - Staging: http://<staging-host>:9480/your-drive
#   - Prod:    https://<your-public-bucket-url>
S3_PUBLIC_URL=http://localhost:9480/your-drive

# MinIO public URLs (only needed when MinIO is behind a reverse proxy).
# Leave empty for local dev. On staging/prod set to your public domains.
# MINIO_BROWSER_REDIRECT_URL: tells the Console what URL to redirect to
#   after login. If unset, it redirects to the internal address and breaks.
# MINIO_SERVER_URL: tells MinIO its public S3 API URL so it generates
#   presigned URLs and API responses with the right hostname.
MINIO_BROWSER_REDIRECT_URL=
MINIO_SERVER_URL=

# =============================================================================
# Optional third-party services
# =============================================================================
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_SERVER_MAPS_API_KEY=
# APPLE_CLIENT_ID=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_FROM_ADDRESS=
# SMS_PROVIDER=sns            # "sns" (default) or "twilio"; in development SMS is skipped unless this is set
# SMS_SENDER_ID=               # optional alphanumeric sender id for SNS (e.g. YourDrive)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# PINDO_ACCESS_TOKEN=
# FIREBASE_SERVICE_JSON_PATH=
# OPENAI_API_KEY=
