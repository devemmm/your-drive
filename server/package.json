{
  "name": "Your-Drive-backend",
  "version": "1.0.0",
  "description": "Node.js Express TypeScript Backend",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "build:deploy": "prisma generate && tsc",
    "compile": "tsc",
    "watch-ts": "tsc -w",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "postinstall": "prisma generate",
    "studio": "prisma studio",
    "migrate:reset": "prisma migrate reset --force",
    "seed": "prisma db seed",
    "seed:test": "ts-node prisma/test-seed.ts",
    "seed:test-users": "ts-node prisma/seed.test-users.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1024.0",
    "@aws-sdk/client-sesv2": "^3.1057.0",
    "@aws-sdk/client-sns": "^3.1090.0",
    "@prisma/client": "^5.22.0",
    "@types/cron": "^2.0.1",
    "@types/json2csv": "^5.0.7",
    "@types/nodemailer": "^6.4.17",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "apple-signin-auth": "^2.0.0",
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "cron": "^4.3.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "firebase-admin": "^13.4.0",
    "google-auth-library": "^10.1.0",
    "helmet": "^7.1.0",
    "i18next": "^25.5.2",
    "i18next-http-middleware": "^3.8.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^7.0.2",
    "openai": "^5.10.2",
    "pindo-sms": "^1.0.5",
    "prisma": "^5.22.0",
    "sharp": "^0.34.1",
    "socket.io": "^4.8.1",
    "stripe": "^18.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^4.23.0",
    "uuid": "^13.0.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
