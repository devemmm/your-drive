SERVER_PORT=3003
NODE_ENV=production
SECRET_KEY=your-jwt-secret-change-me
DEFAULT_CURRENCY=RWF

FRONTEND_URL=http://localhost:8480
BACKEND_URL=http://localhost:3003

# =============================================================================
# Postgres - point at wherever it's actually running.
# From inside the container, host.docker.internal reaches services running
# directly on the host machine (works via the extra_hosts entry in
# server/docker-compose.yml, on both Linux and Mac).
# =============================================================================
DATABASE_URL=postgresql://<user>:<password>@host.docker.internal:5432/<database>

# =============================================================================
# Admin seed credentials
# =============================================================================
ADMIN_EMAIL=admin@yourdrive.com
ADMIN_PASSWORD=Admin123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# =============================================================================
# S3-compatible storage - point at wherever MinIO is actually running.
# =============================================================================
S3_ENDPOINT=http://host.docker.internal:9000
S3_BUCKET=your-drive
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# S3_PUBLIC_URL: what the server writes into the DB for image URLs.
# Must be reachable from browsers/mobile clients.
S3_PUBLIC_URL=http://localhost:9000/your-drive

# =============================================================================
# Optional third-party services
# =============================================================================
# GOOGLE_SERVER_MAPS_API_KEY=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_FROM_ADDRESS=
# SMS_PROVIDER=sns            # "sns" (default) or "twilio"; in development SMS is skipped unless this is set
# SMS_SENDER_ID=               # optional alphanumeric sender id for SNS (e.g. YourDrive)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# PINDO_ACCESS_TOKEN=
# FIREBASE_SERVICE_JSON_PATH=
# OPENAI_API_KEY=
