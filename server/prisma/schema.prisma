model RideRequest {
  id              Int       @id @default(autoincrement())
  userId          Int
  originId        Int?      @unique
  destinationId   Int?      @unique
  date            DateTime
  timeWindowStart DateTime?
  timeWindowEnd   DateTime?
  seats           Int       @default(1)

  // proximity in meters (e.g., 5000 = 5km). Optional, default provided.
  // proximityMeters Int @default(25000)
  status    RideRequestStatus @default(DRAFT)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user          User               @relation(fields: [userId], references: [id])
  matches       RideRequestMatch[]
  origin        Location?          @relation("RideRequestOrigin", fields: [originId], references: [id])
  destination   Location?          @relation("RideRequestDestination", fields: [destinationId], references: [id])
  notifications Notification[]
  rideType      RideType
  closeAt       DateTime?
  expiredAt     DateTime?
  openedAt      DateTime?

  // text-only fields for P2P:
  originCity      String
  originProvince  String
  destCity        String
  destProvince    String
  description     String?
  // Passenger's proposed fare for on-demand ride requests (inDrive-style).
  // When a driver accepts, this becomes the created Ride's contribution.
  proposedFare    Decimal?        @db.Decimal(10, 2)
  vehicleCategory VehicleCategory @default(CAR)
  rides           Ride[]
  bids            RideBid[]
}

enum RideRequestStatus {
  DRAFT
  OPEN
  CLOSED
  EXPIRED
}

enum RideBidStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model RideRequestMatch {
  id        Int         @id @default(autoincrement())
  requestId Int
  rideId    Int
  matchedAt DateTime    @default(now())
  request   RideRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  ride      Ride        @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@unique([requestId, rideId])
}

model RideBid {
  id              Int            @id @default(autoincrement())
  rideRequestId   Int
  driverId        Int
  vehicleId       Int
  bidAmount       Decimal        @db.Decimal(10, 2)
  status          RideBidStatus  @default(PENDING)
  createdAt       DateTime       @default(now())
  resolvedAt      DateTime?

  rideRequest     RideRequest    @relation(fields: [rideRequestId], references: [id], onDelete: Cascade)
  driver          User           @relation("DriverRideBids", fields: [driverId], references: [id], onDelete: Cascade)
  vehicle         Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@unique([rideRequestId, driverId])
  @@index([rideRequestId, status])
  @@index([driverId, status])
}

model DriverPresence {
  userId           Int      @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentVehicleId Int?     @unique
  currentVehicle   Vehicle? @relation("DriverPresenceVehicle", fields: [currentVehicleId], references: [id])
  latitude         Float
  longitude        Float
  accuracy         Float?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@index([updatedAt])
  // Composite btree; useful for latitude-anchored range scans. A true bbox
  // query on both axes would benefit more from PostGIS GiST — revisit if
  // presence volume grows.
  @@index([latitude, longitude])
}

// User report against another party tied to a specific trip (ride, chauffeur, or rental).
// Exactly one of rideId / chauffeurServiceId / rentalId must be set — enforced in the
// service layer. Admin reviews via the admin tabs; flagged rows are highlighted.
model RideReport {
  id                 Int               @id @default(autoincrement())
  rideId             Int?
  ride               Ride?             @relation(fields: [rideId], references: [id], onDelete: Cascade)
  chauffeurServiceId Int?
  chauffeurService   ChauffeurService? @relation(fields: [chauffeurServiceId], references: [id], onDelete: Cascade)
  rentalId           Int?
  rental             CarRental?        @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  reporterId    Int
  reporter      User @relation("ReportReporter", fields: [reporterId], references: [id])
  subjectUserId Int
  subject       User @relation("ReportSubject", fields: [subjectUserId], references: [id])

  reason       String
  status       ReportStatus @default(OPEN)
  reviewNotes  String?
  reviewedById Int?
  reviewedBy   User?        @relation("ReportReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([rideId])
  @@index([chauffeurServiceId])
  @@index([rentalId])
  @@index([status])
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

// Admin-configurable fare rules per (vehicleCategory, rideType). Used to
// suggest a proposedFare in the passenger ride-request flow and to compute
// the commission debited from the driver wallet on completion.
//
// The unique (vehicleCategory, rideType, isActive) lets you keep one active
// rule plus historical inactive rows. commissionPercent overrides the
// singleton CommissionSettings.rate when a matching active row exists.
model PricingSettings {
  id                Int             @id @default(autoincrement())
  vehicleCategory   VehicleCategory
  rideType          RideType
  baseFare          Decimal         @db.Decimal(10, 2)
  perKm             Decimal         @db.Decimal(10, 2)
  perMinute         Decimal         @db.Decimal(10, 2)
  minimumFare       Decimal         @db.Decimal(10, 2)
  commissionPercent Decimal         @default(10) @db.Decimal(5, 2)
  currency          String          @default("RWF")
  isActive          Boolean         @default(true)
  effectiveFrom     DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([vehicleCategory, rideType, isActive])
}
