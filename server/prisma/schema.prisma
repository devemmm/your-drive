generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                             Int                @id @default(autoincrement())
  email                          String             @unique
  firstName                      String?
  lastName                       String?
  password                       String?
  phoneNumber                    String?            @unique
  role                           UserRole           @default(USER)
  isVerified                     Boolean            @default(false)
  isPhoneVerified                Boolean            @default(false)
  verificationCode               String?
  verificationCodeExpiresAt      DateTime?
  phoneVerificationCode          String?
  phoneVerificationCodeExpiresAt DateTime?
  resetToken                     String?
  resetTokenExpiry               DateTime?
  googleId                       String?            @unique
  appleId                        String?            @unique
  language                       Language           @default(EN)
  theme                          String             @default("light")
  status                         Status             @default(ACTIVE)
  isOnboarded                    Boolean            @default(false)
  createdAt                      DateTime           @default(now())
  updatedAt                      DateTime           @updatedAt
  profileImage                   Asset?
  postedRides                    Ride[]
  subscriptions                  UserSubscription[]
  vehicles                       Vehicle[]
  averageRating                  Float              @default(0)
  totalRatings                   Int                @default(0)

  // Onboarding and profile fields
  dateOfBirth          DateTime?
  notificationPref     NotificationPreference @default(IN_APP)
  twoFactorEnabled     Boolean                @default(false)
  termsAccepted        Boolean                @default(false)
  isPassengerOnboarded Boolean                @default(false)
  isDriverOnboarded    Boolean                @default(false)

  // Passenger fields
  travelPreferences     RidePreference?
  frequentRoutes        Json?
  emergencyContactName  String?
  emergencyContactPhone String?
  referralCode          String          @unique
  sentReferrals         Referral[]      @relation("UserInviter")
  receivedReferral      Referral?       @relation("UserInvitee")

  // Driver fields
  licenseNumber             String?
  licenseImageId            Int?             @unique
  licenseImage              Asset?           @relation("LicenseImage", fields: [licenseImageId], references: [id], onDelete: SetNull)
  drivingExperience         String?
  licenseImages             LicenseImages?
  transactions              Transaction[]
  notifications             Notification[]
  fcm_token                 String?
  bookings                  Booking[]
  stripeCustomerId          String?          @unique // For Stripe integration
  cancelledBookings         Booking[]        @relation("BookingCanceller")
  chatMessages              ChatMessage[]
  chatThreads               ChatThread[]     @relation("UsersOnThreads")
  coupons                   Coupon[]
  reviewedCancellationRides Ride[]           @relation("RideCancellationReviewer")
  blockedRides              Ride[]           @relation("RideBlocker")
  redeemedCoupons           RedeemedCoupon[]

  driverReviews Review[] @relation("DriverReviews")

  userReviews            Review[]            @relation("UserReviews")
  stripeAccountId        String?             @unique
  isStripeOnboarded      Boolean             @default(false)
  messageReads           MessageRead[] // Track which messages this user has read
  isDeleted              Boolean             @default(false) // Soft delete flag
  deletedAt              DateTime? // When the user was deleted
  isEmailVerified        Boolean             @default(false)
  isWelcomeEmailSent     Boolean             @default(false)
  ownedThreads           ChatThread[]
  acceptedReceiveUpdates Boolean             @default(false)
  noShows                NoShow[]            @relation(name: "NoShowUser")
  reportedNoShows        NoShow[]            @relation(name: "NoShowReportedBy")
  suspendedAt            DateTime?
  suspendUntil           DateTime? // Optional, if the user is suspended until a specific date
  suspensionReason       String? // Reason for suspension, if applicable
  reviewedNoShows        NoShow[]            @relation("NoShowReviewer")
  paymentSessions        PaymentSession[]
  billingAddress         Json?
  d2dBookingRequests     D2DBookingRequest[] @relation("PassengerRequests")
  rideRequests           RideRequest[]

  renterRentals    CarRental[] @relation("RenterRentals")
  ownerRentals     CarRental[] @relation("OwnerRentals")
  cancelledRentals CarRental[] @relation("RentalCancelledBy")

  // Chauffeur driver fields
  isAvailableForChauffeur Boolean  @default(false)
  chauffeurHourlyRate     Decimal? @db.Decimal(10, 2)
  chauffeurDailyRate      Decimal? @db.Decimal(10, 2)
  chauffeurDescription    String?
  // ISO 639-1 codes (e.g. ["en","rw","fr"]). Shown in chauffeur picker.
  languagesSpoken         Json?

  // On-demand ride-request driver availability
  isAvailableForRideRequest Boolean @default(false)

  passengerChauffeurServices ChauffeurService[] @relation("PassengerChauffeurServices")
  driverChauffeurServices    ChauffeurService[] @relation("DriverChauffeurServices")
  cancelledChauffeurServices ChauffeurService[] @relation("ChauffeurCancelledBy")

  presence DriverPresence?

  // Wallet fields
  walletBalanceCents   Int        @default(0)
  walletDebtLimitCents Int?
  operatorRoutes       BusRoute[] @relation("OperatorRoutes")

  reportsFiled    RideReport[] @relation("ReportReporter")
  reportsAgainst  RideReport[] @relation("ReportSubject")
  reportsReviewed RideReport[] @relation("ReportReviewer")

  // KYC for becoming a driver. Defaults to PENDING; admin promotes to APPROVED.
  // Going online (isAvailableForRideRequest) and adding a vehicle are gated on
  // kycStatus = APPROVED — see auth/driver-presence controllers.
  kycStatus        KycStatus @default(PENDING)
  kycReviewedAt    DateTime?
  kycReviewedById  Int?
  kycReviewedBy    User?     @relation("UserKycReviewer", fields: [kycReviewedById], references: [id])
  kycReviewedUsers User[]    @relation("UserKycReviewer")
  kycReviewNotes   String?

  reviewedVehicleKyc Vehicle[] @relation("VehicleKycReviewer")

  rideBids      RideBid[] @relation("DriverRideBids")
  lastBidPushAt DateTime?
}

model LicenseImages {
  id           Int  @id @default(autoincrement())
  userId       Int  @unique
  frontImageId Int? @unique
  backImageId  Int? @unique

  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  frontImage Asset? @relation("FrontLicenseImage", fields: [frontImageId], references: [id], onDelete: SetNull)
  backImage  Asset? @relation("BackLicenseImage", fields: [backImageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Referral {
  id        Int      @id @default(autoincrement())
  inviterId Int
  inviteeId Int      @unique
  createdAt DateTime @default(now())

  inviter User @relation("UserInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User @relation("UserInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
}

enum NotificationPreference {
  EMAIL
  SMS
  IN_APP
}

model Ride {
  id                    Int      @id @default(autoincrement())
  departureTime         DateTime
  departureLocationId   Int      @unique
  destinationLocationId Int      @unique
  isLocked              Boolean  @default(false) // added to match controller usage
  appliedDriverCoupons  Boolean  @default(false) // or whatever type is appropriate

  stopovers      Location[] @relation("Stopovers")
  availableSeats Int
  totalSeats     Int
  contribution   Float

  preferences                        RidePreference?
  bookingType                        BookingType                  @default(AUTOMATIC)
  status                             RideStatus                   @default(DRAFT)
  driverId                           Int
  driver                             User                         @relation(fields: [driverId], references: [id])
  vehicleId                          Int
  vehicle                            Vehicle                      @relation(fields: [vehicleId], references: [id])
  createdAt                          DateTime                     @default(now())
  updatedAt                          DateTime                     @updatedAt
  isBlocked                          Boolean                      @default(false)
  estimatedArrivalTime               DateTime?
  departureLocation                  Location                     @relation("RideDeparture", fields: [departureLocationId], references: [id])
  destinationLocation                Location                     @relation("RideDestination", fields: [destinationLocationId], references: [id])
  transactions                       Transaction[]
  reviews                            Review[]
  // This is just for clarity and analytics which shows how did the user post a ride, PAYMENT if paid posting fee,
  // SUBSCRIPTION if had subscription, coupon if used coupons, FREE if had a granted a free posting
  monitizationType                   MonetizationType             @default(PAYMENT)
  postingSubscriptionId              Int?
  subscription                       UserSubscription?            @relation(fields: [postingSubscriptionId], references: [id])
  contributionCollectionMethod       ContributionCollectionMethod @default(VIA_PLATFORM)
  bookings                           Booking[]
  chatThread                         ChatThread?
  bookingSeats                       BookingSeat[]
  noShows                            NoShow[]
  reports                            RideReport[]
  startedAt                          DateTime?
  completedAt                        DateTime?
  publishedAt                        DateTime?
  detourRadius                       Int?
  extraKmPrice                       Float?                       @default(0)
  cancelledAt                        DateTime?
  cancellationReason                 String?
  cancellationReviewed               Boolean?
  cancellationReviewedAt             DateTime?
  cancellationReviewedById           Int? // Admin who reviewed the cancellation
  cancellationReviewer               User?                        @relation("RideCancellationReviewer", fields: [cancellationReviewedById], references: [id])
  cancellationCountsAgainstAllowance YesNo                        @default(NO) // If YES, this cancellation counts toward  Driver cancellation allowance
  isDeleted                          Boolean                      @default(false)
  deletedAt                          DateTime? // When the ride was deleted, if applicable
  blockedAt                          DateTime? // When the ride was blocked, if applicable
  blockingReason                     String? // Reason for blocking the ride
  blockerId                          Int? // User who blocked the ride
  blocker                            User?                        @relation("RideBlocker", fields: [blockerId], references: [id])
  isRideCompleteReminderSent         Boolean?
  isThirtyMinReminderSent            Boolean?
  isStartReminderSent                Boolean?
  isSettled                          Boolean                      @default(false) // Whether the ride has been settled (e.g., all payments processed)
  settlementFailedReason             String? // If settlement failed, reason for failure
  paymentSessions                    PaymentSession[]
  rideRequestMatches                 RideRequestMatch[]
  d2dBookingRequests                 D2DBookingRequest[]
  type                               RideType                     @default(P2P)
  notifications                      Notification[]
  isDriverCouponIssuedOnCompletion   Boolean                      @default(false)
  settlementProcessingAt             DateTime?
  rideRequestId                      Int?
  rideRequest                        RideRequest?                 @relation(fields: [rideRequestId], references: [id], onDelete: SetNull)

  // Bus route association
  routeId Int?
  route   BusRoute? @relation(fields: [routeId], references: [id])

  // Recurring schedule association (a materialized occurrence of a departure)
  routeDepartureId Int?
  routeDeparture   BusRouteDeparture? @relation(fields: [routeDepartureId], references: [id])

  @@index([routeId, departureTime])
  @@unique([routeDepartureId, departureTime])
}

model BusRoute {
  id         Int            @id @default(autoincrement())
  operatorId Int
  operator   User           @relation("OperatorRoutes", fields: [operatorId], references: [id])
  originCity String
  destCity   String
  distanceKm Float
  basePrice  Decimal        @db.Decimal(10, 2)
  isActive   Boolean        @default(true)
  stops      BusRouteStop[]
  rides      Ride[]
  departures BusRouteDeparture[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([originCity, destCity, isActive])
}

model BusRouteDeparture {
  id        Int      @id @default(autoincrement())
  routeId   Int
  route     BusRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  timeOfDay String   // "HH:mm" 24h, operator local time
  vehicleId Int
  vehicle   Vehicle  @relation("VehicleScheduleDepartures", fields: [vehicleId], references: [id])
  isActive  Boolean  @default(true)
  rides     Ride[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([routeId, isActive])
}

model BusRouteStop {
  id        Int      @id @default(autoincrement())
  routeId   Int
  route     BusRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name      String
  city      String
  order     Int
  latitude  Float?
  longitude Float?

  boardingBookings  Booking[] @relation("BookingBoardingStop")
  alightingBookings Booking[] @relation("BookingAlightingStop")

  @@index([routeId, order])
}

enum RideType {
  D2D
  P2P
}

enum VehicleCategory {
  CAR
  MOTORBIKE
  BUS
}

model D2DBookingRequest {
  id                     Int                     @id @default(autoincrement())
  rideId                 Int
  ride                   Ride                    @relation(fields: [rideId], references: [id])
  passengerId            Int
  passenger              User                    @relation("PassengerRequests", fields: [passengerId], references: [id])
  pickupLocationId       Int                     @unique
  dropoffLocationId      Int                     @unique
  pickupLocation         Location                @relation("PickupLocation", fields: [pickupLocationId], references: [id])
  dropoffLocation        Location                @relation("DropoffLocation", fields: [dropoffLocationId], references: [id])
  detourDistance         Float?
  pickupDetourDistance   Float?
  droppoffDetourDistance Float?
  totalAmount            Decimal                 @db.Decimal(10, 2)
  status                 D2DBookingRequestStatus @default(POSTED)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  completedAt            DateTime?
  acceptedAt             DateTime?
  canceledAt             DateTime?
  declinedAt             DateTime?
  canceledBy             String?
  confirmedAt            DateTime?
  extraKms               Float?
  extraKmsAmount         Decimal?                @db.Decimal(10, 2)
  pickupExtraKms         Float?
  dropoffExtraKms        Float?
  reason                 String?
  transactionId          Int?                    @unique
  transaction            Transaction?            @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  bookingSeat            BookingSeat?
  redeemedCoupns         RedeemedCoupon[]
  paymentSession         PaymentSession[]
  couponsIssued          Boolean                 @default(false)
  expiredAt              DateTime?
  disputedAt             DateTime?
  disputeResolvedAt      DateTime?
}

enum D2DBookingRequestStatus {
  POSTED
  ACCEPTED
  CONFIRMED
  CANCELED
  DECLINED
  COMPLETED
  EXPIRED
  DISPUTED
}

enum YesNo {
  YES
  NO
}

model Booking {
  id                 Int           @id @default(autoincrement())
  rideId             Int
  vehicleId          Int
  transactionId      Int?          @unique
  seats              Int
  paymentTransaction Transaction?  @relation(fields: [transactionId], references: [id])
  status             BookingStatus @default(PENDING)
  ride               Ride          @relation(fields: [rideId], references: [id])
  vehicle            Vehicle       @relation(fields: [vehicleId], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // This is just for clarity and analytics which shows how did the user book, PAYMENT if paid booking fee,
  // SUBSCRIPTION if had subscription, coupon if used coupons, FREE if had a granted a free booking
  monitizationType  MonetizationType @default(PAYMENT)
  userId            Int
  booker            User             @relation(fields: [userId], references: [id])
  cancellerId       Int?
  cancelledBy       User?            @relation("BookingCanceller", fields: [cancellerId], references: [id])
  cancelledAt       DateTime?
  reason            String?
  bookingSeats      BookingSeat[]
  redeemedCoupns    RedeemedCoupon[]
  couponsIssued     Boolean          @default(false)
  expiredAt         DateTime?
  disputedAt        DateTime?
  disputeResolvedAt DateTime?

  // Bus stop fields
  boardingStopId  Int?
  boardingStop    BusRouteStop? @relation("BookingBoardingStop", fields: [boardingStopId], references: [id], onDelete: Restrict)
  alightingStopId Int?
  alightingStop   BusRouteStop? @relation("BookingAlightingStop", fields: [alightingStopId], references: [id], onDelete: Restrict)
}

model BookingSeat {
  id             Int       @id @default(autoincrement())
  bookingId      Int?
  booking        Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  attendanceCode String    @unique
  attendedAt     DateTime?
  createdAt      DateTime  @default(now())
  rideId         Int
  ride           Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  isExpired      Boolean   @default(false) // If a seat is expired (e.g., ride cancelled, booking cancelled)
  expireReason   String? // Reason for expiration
  expiredAt      DateTime?

  d2dBookingId Int?               @unique
  d2dBooking   D2DBookingRequest? @relation(fields: [d2dBookingId], references: [id], onDelete: Cascade)
  lockedUntil  DateTime?
}

model Vehicle {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  make        String // e.g., Toyota
  model       String // e.g., Corolla
  year        Int?
  color       String
  plateNumber String
  category    VehicleCategory @default(CAR)
  verified    Boolean         @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  capacity  Int      @default(4) // Number of seats available

  rides              Ride[]
  scheduleDepartures BusRouteDeparture[] @relation("VehicleScheduleDepartures")
  files          Asset[]
  defaultImageId Int?      @unique
  defaultImage   Asset?    @relation("DefaultImage", fields: [defaultImageId], references: [id], onDelete: SetNull)
  Booking        Booking[]

  isAvailableForRental     Boolean            @default(false)
  hourlyRate               Decimal?           @db.Decimal(10, 2)
  dailyRate                Decimal?           @db.Decimal(10, 2)
  securityDeposit          Decimal?           @db.Decimal(10, 2)
  rentalDescription        String?
  pickupLocationId         Int?               @unique
  pickupLocation           Location?          @relation("VehiclePickupLocation", fields: [pickupLocationId], references: [id], onDelete: SetNull)
  mileageLimit             Int?
  fuelPolicy               FuelPolicy?
  rentals                  CarRental[]
  chauffeurServices        ChauffeurService[]
  presenceAsCurrentVehicle DriverPresence?    @relation("DriverPresenceVehicle")
  seatLayout               Json?

  // Vehicle spec metadata (rental clients ask for these).
  transmission Transmission?
  fuelType     FuelType?
  // Operational status: AVAILABLE by default; owner/admin can flip to
  // MAINTENANCE / DISABLED. Filters out the vehicle from new bookings / rides.
  status       VehicleStatus @default(AVAILABLE)
  // Service tier — used by ride pricing & matchmaking filters.
  tier         VehicleTier?

  blockedRanges VehicleBlockedRange[]

  // KYC for the vehicle (yellow card, insurance, authorization, photos).
  // PENDING by default; admin promotes to APPROVED before vehicle can be
  // used for rides / D2D / chauffeur / rentals.
  kycStatus       KycStatus @default(PENDING)
  kycReviewedAt   DateTime?
  kycReviewedById Int?
  kycReviewedBy   User?     @relation("VehicleKycReviewer", fields: [kycReviewedById], references: [id])
  kycReviewNotes  String?

  rideBids RideBid[]
}

// Owner / admin-set blocked date ranges for a vehicle (maintenance, owner
// keeping the car, etc). Booking creation rejects overlap with active rentals
// AND with these.
model VehicleBlockedRange {
  id        Int      @id @default(autoincrement())
  vehicleId Int
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  from      DateTime
  to        DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([vehicleId, from, to])
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
}

enum VehicleStatus {
  AVAILABLE
  MAINTENANCE
  DISABLED
}

enum VehicleTier {
  ECONOMY
  PREMIUM
}

model CarRental {
  id        Int     @id @default(autoincrement())
  vehicleId Int
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  renterId  Int
  renter    User    @relation("RenterRentals", fields: [renterId], references: [id], onDelete: Cascade)
  ownerId   Int
  owner     User    @relation("OwnerRentals", fields: [ownerId], references: [id], onDelete: Cascade)

  startDate             DateTime
  endDate               DateTime
  rentalType            RentalType
  totalAmount           Decimal      @db.Decimal(10, 2)
  securityDepositAmount Decimal      @db.Decimal(10, 2)
  status                RentalStatus @default(REQUESTED)

  pickupLocationId Int?      @unique
  pickupLocation   Location? @relation("RentalPickupLocation", fields: [pickupLocationId], references: [id], onDelete: SetNull)
  returnLocationId Int?      @unique
  returnLocation   Location? @relation("RentalReturnLocation", fields: [returnLocationId], references: [id], onDelete: SetNull)
  pickupNotes      String?
  returnNotes      String?

  approvedAt         DateTime?
  declinedAt         DateTime?
  activatedAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellerId        Int?
  cancelledBy        User?     @relation("RentalCancelledBy", fields: [cancellerId], references: [id], onDelete: SetNull)
  cancellationReason String?

  depositRefunded   Boolean   @default(false)
  depositRefundedAt DateTime?

  pickupReminderSent         Boolean   @default(false)
  returnReminderSent         Boolean   @default(false)
  overdueNotifiedAt          DateTime?
  depositReleaseReminderSent Boolean   @default(false)

  transactionId        Int?         @unique
  transaction          Transaction? @relation("RentalTransaction", fields: [transactionId], references: [id], onDelete: SetNull)
  depositTransactionId Int?         @unique
  depositTransaction   Transaction? @relation("RentalDepositTransaction", fields: [depositTransactionId], references: [id], onDelete: SetNull)

  chatThread    ChatThread?
  reviews       Review[]
  notifications Notification[]
  reports       RideReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RentalSettings {
  id                          Int      @id @default(autoincrement())
  platformFeePercentage       Decimal  @default(15) @db.Decimal(5, 2)
  maxRentalDurationDays       Int      @default(30)
  minRentalDurationHours      Int      @default(1)
  requestExpiryHours          Int      @default(24)
  depositReleaseReminderHours Int      @default(24)
  overdueGracePeriodHours     Int      @default(3)
  // Cancellation refund tiers, percent of totalAmount returned to renter.
  // Bucketed by hours before scheduled start.
  cancelRefundPctOver24h      Decimal  @default(100) @db.Decimal(5, 2)
  cancelRefundPct12To24h      Decimal  @default(80) @db.Decimal(5, 2)
  cancelRefundPctUnder12h     Decimal  @default(50) @db.Decimal(5, 2)
  noShowRefundPct             Decimal  @default(0) @db.Decimal(5, 2)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model ChauffeurService {
  id          Int      @id @default(autoincrement())
  vehicleId   Int?
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  passengerId Int
  passenger   User     @relation("PassengerChauffeurServices", fields: [passengerId], references: [id], onDelete: Cascade)
  driverId    Int
  driver      User     @relation("DriverChauffeurServices", fields: [driverId], references: [id], onDelete: Cascade)

  startDate   DateTime
  endDate     DateTime
  serviceType ChauffeurServiceType
  totalAmount Decimal              @db.Decimal(10, 2)
  status      ChauffeurStatus      @default(REQUESTED)

  pickupLocationId  Int?      @unique
  pickupLocation    Location? @relation("ChauffeurPickupLocation", fields: [pickupLocationId], references: [id], onDelete: SetNull)
  dropoffLocationId Int?      @unique
  dropoffLocation   Location? @relation("ChauffeurDropoffLocation", fields: [dropoffLocationId], references: [id], onDelete: SetNull)
  pickupNotes       String?
  dropoffNotes      String?

  acceptedAt         DateTime?
  declinedAt         DateTime?
  activatedAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellerId        Int?
  cancelledBy        User?     @relation("ChauffeurCancelledBy", fields: [cancellerId], references: [id], onDelete: SetNull)
  cancellationReason String?

  pickupReminderSent     Boolean   @default(false)
  completionReminderSent Boolean   @default(false)
  overdueNotifiedAt      DateTime?

  transactionId Int?         @unique
  transaction   Transaction? @relation("ChauffeurTransaction", fields: [transactionId], references: [id], onDelete: SetNull)

  chatThread    ChatThread?
  reviews       Review[]
  notifications Notification[]
  reports       RideReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChauffeurSettings {
  id                      Int      @id @default(autoincrement())
  platformFeePercentage   Decimal  @default(15) @db.Decimal(5, 2)
  maxServiceDurationDays  Int      @default(30)
  minServiceDurationHours Int      @default(1)
  requestExpiryHours      Int      @default(24)
  overdueGracePeriodHours Int      @default(3)
  // Cancellation refund tiers — same shape as RentalSettings.
  cancelRefundPctOver24h  Decimal  @default(100) @db.Decimal(5, 2)
  cancelRefundPct12To24h  Decimal  @default(80) @db.Decimal(5, 2)
  cancelRefundPctUnder12h Decimal  @default(50) @db.Decimal(5, 2)
  noShowRefundPct         Decimal  @default(0) @db.Decimal(5, 2)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Asset {
  id                 Int            @id @default(autoincrement())
  url                String
  type               AssetType
  category           AssetCategory
  publicId           String
  vehicleId          Int?
  userId             Int?           @unique
  createdAt          DateTime       @default(now())
  user               User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle            Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  defaultedToVehicle Vehicle?       @relation("DefaultImage")
  licenseForUser     User?          @relation("LicenseImage")
  frontLicense       LicenseImages? @relation("FrontLicenseImage")
  backLicense        LicenseImages? @relation("BackLicenseImage")
}

