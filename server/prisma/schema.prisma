model Transaction {
  id                Int               @id @default(autoincrement())
  transactionId     String?           @unique @default(uuid())
  userId            Int
  rideId            Int?
  type              TransactionType // enum: RIDE_POSTING, BOOKING, etc
  amount            Float // original amount intended to be charged for the transaction platformAmount + driverAmount
  status            TransactionStatus @default(PENDING)
  paymentProvider   PaymentProvider   @default(STRIPE)
  externalReference String?           @unique // for external transaction tracking
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  refundedAmount    Float             @default(0) // amount refunded if any
  isRefunded        Boolean           @default(false) // if the transaction has been refunded
  planId            Int?

  user                  User               @relation(fields: [userId], references: [id])
  ride                  Ride?              @relation(fields: [rideId], references: [id])
  booking               Booking?
  plan                  SubscriptionPlan?  @relation(fields: [planId], references: [id])
  currency              String             @default("RWF") // Currency code, e.g., RWF, USD, EUR
  platformAmount        Float
  driverAmount          Float              @default(0) // Amount that goes to the driver
  refundedAt            DateTime?
  // trasfer driverAmount to driver
  stripeChargeId        String?            @unique
  stripeTransferId      String?            @unique // For tracking transfers to the driver, if applicable
  transferFailureReason String? // Reason for transfer failure, if any
  // stripeChargeAccount  StripeChargeAccount @default(PLATFORM) // This is to determine which account the charged funds against(settle)
  isDriverPaid          Boolean            @default(false) // This will mean that the driver potion has been transered to a connected accout
  driverNetAmountPaid   Float? // Net amount transfered to driver after charges(stripe fee)
  driverStripeFee       Float? // Stripe fee applied to the driver amount
  platformStripeFee     Float? // Stripe fee applied to the platform amount
  platformNetAmount     Float? // Net platform amount after external charges(stripe fee) and tax if applied
  // isTransferReversed          Boolean           @default(false)
  grossReceivedAmount   Float? // Gross amount charged from (paid by)  a customer
  netReceivedAmount     Float? // Net amount received after provider fees (e.g., Stripe fees)
  // platformGrossReceivedAmount Float? // Gross platform share based on amount chareged from the customer
  // driverGrossReceivedAmount   Float? // Gross driver share  based on amount chareged from the customer
  billingAddress        Json? // Billing address for the transaction, if applicable
  transactionDate       DateTime? // Date when the transaction occurred
  paymentReceipt        PaymentReceipt?
  paymentSessionId      String?            @unique
  paymentSession        PaymentSession?    @relation(fields: [paymentSessionId], references: [id])
  discountPct           Decimal            @default(0) @db.Decimal(5, 2)
  discount              Decimal            @default(0) @db.Decimal(5, 2)
  couponsUsed           Decimal            @default(0) @db.Decimal(5, 2)
  d2dBookingReq         D2DBookingRequest?
  disputedAt            DateTime?
  disputeResolvedAt     DateTime?
  driverPaidAt          DateTime?

  rental        CarRental? @relation("RentalTransaction")
  rentalDeposit CarRental? @relation("RentalDepositTransaction")

  chauffeurService ChauffeurService? @relation("ChauffeurTransaction")
}

enum TransactionType {
  RIDE_POSTING
  RIDE_BOOKING
  SUBSCRIPTION
  CAR_RENTAL
  CAR_RENTAL_DEPOSIT
  CHAUFFEUR_SERVICE
  COMMISSION_DEBIT
  WALLET_CREDIT
}

